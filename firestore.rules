/**
 * # Core Philosophy
 * This ruleset enforces a strict user-ownership security model combined with a
 * collaborative, role-based model for shared resources (shops). The primary
 * goal is to ensure that users can only access their own data, and that access
 * to shop data is restricted to the shop's owner and its registered members.
 *
 * # Data Structure
 * - `/users/{userId}`: Contains private user profile data, accessible only by
 *   the authenticated user.
 * - `/users/{userId}/shops/{shopId}`: A user's owned shops are nested directly
 *   under their user document. This path-based ownership makes the `userId` the
 *   definitive owner of the shop.
 * - `/users/{userId}/shops/{shopId}/*`: All shop-related data (products,
 *   transactions, categories, etc.) is nested under its parent shop, inheriting
 *   access controls from that shop.
 * - `/roles_admin/{userId}`: A top-level collection that grants global admin
 *   privileges. The existence of a document with the user's UID as the ID
 *   marks them as an admin.
 *
 * # Key Security Decisions
 * - User Isolation: Users cannot read or list other users' profiles. This is
 *   enforced by denying `list` operations on the `/users` collection and
 *   restricting `get` to the document owner.
 * - Shop Collaboration: While the shop's path indicates the owner, access is
 *   extended to other users (employees). This is achieved by checking for the
 *   requesting user's UID within a denormalized `members` map on the shop document
 *   itself.
 * - Admin Privilege: A special top-level collection `/roles_admin` is used to
 *   manage global administrators. Only existing admins can add or remove other
 *   admins.
 *
 * # Denormalization for Authorization
 * To ensure security rules are performant and scalable, this ruleset relies on
 * denormalizing authorization data. To grant collaborators (employees) access to
 * a shop and its subcollections, the `/users/{userId}/shops/{shopId}` document
 * MUST contain a `members` map.
 *
 * Example `Shop` document at `/users/owner_abc/shops/shop_123`:
 * {
 *   name: "My Awesome Shop",
 *   ownerId: "owner_abc",
 *   members: {
 *     "employee_xyz": "seller",
 *     "manager_pqr": "admin"
 *   }
 * }
 *
 * The `isShopMemberOrOwner()` function uses a single `get()` to read this map,
 * granting access to the owner and all members efficiently without needing to
 * query other collections.
 *
 * # Structural Segregation
 * User data and shop data are cleanly separated by nesting shops under the user
 * who owns them. This path-based approach provides a clear and secure boundary
 * between different users' data domains.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication and authorization checks.
    
    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the authenticated user's UID matches the provided userId.
     * This is the foundation of the user-ownership model.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks if the document being accessed already exists.
     * CRITICAL for preventing writes to non-existent documents.
     */
    function isExistingDoc() {
      return resource != null;
    }

    /**
     * Combines owner and existence checks for update/delete operations.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && isExistingDoc();
    }
    
    /**
     * Checks if the current user has global admin privileges.
     * This is determined by the existence of a document in the /roles_admin collection.
     */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * Checks if the user is the owner of a shop (based on path) or a registered
     * member (based on a denormalized `members` map on the shop document).
     * This is the core function for securing all shop-related subcollections.
     */
    function isShopMemberOrOwner(userId, shopId) {
      let shopData = get(/databases/$(database)/documents/users/$(userId)/shops/$(shopId)).data;
      return isOwner(userId) || (isSignedIn() && request.auth.uid in shopData.members);
    }
    
    /**
     * Validates that the user is creating their own user document and that the
     * internal 'id' field matches their UID for data consistency.
     */
    function isCreatingOwnUserDoc(userId) {
      return isOwner(userId) && request.resource.data.id == userId;
    }

    /**
     * Validates that a user is updating their own document and that the 'id'
     * field, which links to their auth UID, remains immutable.
     */
    function isUpdatingOwnUserDoc(userId) {
      return isOwner(userId) && request.resource.data.id == resource.data.id;
    }


    /**
     * @description Manages user profiles. A user can only access their own profile.
     * @path /users/{userId}
     * @allow A logged-in user (auth.uid='user123') can (create) their own document at /users/user123.
     * @deny A logged-in user (auth.uid='user123') cannot (get) another user's document at /users/user456.
     * @principle Restricts access to a user's own data tree and prevents user enumeration.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isCreatingOwnUserDoc(userId);
      allow update: if isUpdatingOwnUserDoc(userId) && isExistingDoc();
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages global admin roles. Only existing admins can manage other admins.
     * @path /roles_admin/{userId}
     * @allow An existing admin can (create) a new document at /roles_admin/newUser.
     * @deny A non-admin user cannot (create), (update), or (delete) any document in this collection.
     * @principle Enforces hierarchical permissions where only privileged users can grant privileges.
     */
    match /roles_admin/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isAdmin() && isExistingDoc();
    }

    /**
     * @description Manages shop documents. Access is granted to the owner (from path) or members (from denormalized map).
     * @path /users/{userId}/shops/{shopId}
     * @allow The owner (auth.uid='user123') can (create) a shop at /users/user123/shops/shopABC.
     * @deny A random user (auth.uid='user456') cannot (get) or (update) a shop at /users/user123/shops/shopABC.
     * @principle Enforces document ownership and shared access via a denormalized members list.
     */
    match /users/{userId}/shops/{shopId} {
      allow get, list: if isShopMemberOrOwner(userId, shopId);
      allow create: if isOwner(userId) && request.resource.data.ownerId == userId;
      allow update: if isShopMemberOrOwner(userId, shopId) && isExistingDoc() && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner(userId) && isExistingDoc();
    }

    /**
     * @description Manages user roles within a shop. Access is inherited from the parent shop.
     * @path /users/{userId}/shops/{shopId}/userShopRoles/{userShopRoleId}
     * @allow A member of 'shopABC' can (list) roles at /users/user123/shops/shopABC/userShopRoles.
     * @deny A non-member cannot (get) any document in this subcollection.
     * @principle Inherits permissions from a parent document to secure a data subtree.
     */
    match /users/{userId}/shops/{shopId}/userShopRoles/{userShopRoleId} {
      allow get, list: if isShopMemberOrOwner(userId, shopId);
      allow create: if isShopMemberOrOwner(userId, shopId) && request.resource.data.shopId == shopId && request.resource.data.userId != null;
      allow update, delete: if isShopMemberOrOwner(userId, shopId) && isExistingDoc();
    }

    /**
     * @description Manages products for a shop. Access is inherited from the parent shop.
     * @path /users/{userId}/shops/{shopId}/products/{productId}
     * @allow A member of 'shopABC' can (create) a product at /users/user123/shops/shopABC/products/prod1.
     * @deny A non-member cannot (list) products in this subcollection.
     * @principle Inherits permissions from a parent document to secure a data subtree.
     */
    match /users/{userId}/shops/{shopId}/products/{productId} {
      allow get, list: if isShopMemberOrOwner(userId, shopId);
      allow create: if isShopMemberOrOwner(userId, shopId) && request.resource.data.shopId == shopId;
      allow update: if isShopMemberOrOwner(userId, shopId) && isExistingDoc() && request.resource.data.shopId == resource.data.shopId;
      allow delete: if isShopMemberOrOwner(userId, shopId) && isExistingDoc();
    }

    /**
     * @description Manages product categories for a shop. Access is inherited from the parent shop.
     * @path /users/{userId}/shops/{shopId}/categories/{categoryId}
     * @allow A member of 'shopABC' can (get) a category at /users/user123/shops/shopABC/categories/cat1.
     * @deny A non-member cannot (create) a category in this subcollection.
     * @principle Inherits permissions from a parent document to secure a data subtree.
     */
    match /users/{userId}/shops/{shopId}/categories/{categoryId} {
      allow get, list: if isShopMemberOrOwner(userId, shopId);
      allow create: if isShopMemberOrOwner(userId, shopId) && request.resource.data.shopId == shopId;
      allow update: if isShopMemberOrOwner(userId, shopId) && isExistingDoc() && request.resource.data.shopId == resource.data.shopId;
      allow delete: if isShopMemberOrOwner(userId, shopId) && isExistingDoc();
    }

    /**
     * @description Manages sales transactions for a shop. Access is inherited from the parent shop.
     * @path /users/{userId}/shops/{shopId}/transactions/{transactionId}
     * @allow A member of 'shopABC' can (create) a transaction at /users/user123/shops/shopABC/transactions/trx1.
     * @deny A non-member cannot (update) a transaction in this subcollection.
     * @principle Inherits permissions from a parent document to secure a data subtree.
     */
    match /users/{userId}/shops/{shopId}/transactions/{transactionId} {
      allow get, list: if isShopMemberOrOwner(userId, shopId);
      allow create: if isShopMemberOrOwner(userId, shopId) && request.resource.data.shopId == shopId;
      allow update: if isShopMemberOrOwner(userId, shopId) && isExistingDoc() && request.resource.data.shopId == resource.data.shopId;
      allow delete: if isShopMemberOrOwner(userId, shopId) && isExistingDoc();
    }

    /**
     * @description Manages items within a transaction. Access is inherited from the parent shop.
     * @path /users/{userId}/shops/{shopId}/transactions/{transactionId}/transactionItems/{transactionItemId}
     * @allow A member of 'shopABC' can (list) items for a transaction.
     * @deny A non-member cannot (get) any transaction item.
     * @principle Inherits permissions from a parent document to secure a data subtree.
     */
    match /users/{userId}/shops/{shopId}/transactions/{transactionId}/transactionItems/{transactionItemId} {
      allow get, list: if isShopMemberOrOwner(userId, shopId);
      allow create: if isShopMemberOrOwner(userId, shopId) && request.resource.data.transactionId == transactionId;
      allow update, delete: if isShopMemberOrOwner(userId, shopId) && isExistingDoc();
    }

    /**
     * @description Manages low stock alerts for a shop. Access is inherited from the parent shop.
     * @path /users/{userId}/shops/{shopId}/stockAlerts/{stockAlertId}
     * @allow A member of 'shopABC' can (get) a stock alert.
     * @deny A non-member cannot (create) a stock alert.
     * @principle Inherits permissions from a parent document to secure a data subtree.
     */
    match /users/{userId}/shops/{shopId}/stockAlerts/{stockAlertId} {
      allow get, list: if isShopMemberOrOwner(userId, shopId);
      allow create: if isShopMemberOrOwner(userId, shopId);
      allow update, delete: if isShopMemberOrOwner(userId, shopId) && isExistingDoc();
    }
  }
}